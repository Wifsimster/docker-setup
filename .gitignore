# Ignore everything
*

# But not these
!.gitignore
!*/
!**/compose.yml
!**/hwaccel.*.yml
!visiophone/Dockerfile
!visiophone/bridge.py
!CLAUDE.md
!AGENTS.md
!docs/*.md
!docs/adr/*.md
!home-assistant/config/automations.yaml
!home-assistant/config/scripts.yaml
!home-assistant/config/scenes.yaml
!home-assistant/config/configuration.yaml
!home-assistant/config/.storage/lovelace.lovelace
!home-assistant/config/.storage/lovelace.my_home
!home-assistant/config/.storage/lovelace.map
!home-assistant/config/.storage/lovelace_dashboards
!litellm/config.yaml
!pg-backup/backup.sh
!pg-backup/crontab

# Backup / maintenance scripts. No secrets in them — they source credentials
# from /root/.borg-photos.env and /root/.borg-discord-webhook at runtime.
!photos-backup.sh
!state-backup.sh
!borg-check.sh
!ha-config-backup.sh
!gramps-backup.sh
!disk-cleanup.sh
!disk-guard.sh
!backup-watch.sh
# digest: publish.py et send-mail.py restent hors git (adresses de la famille).
!digest/collect.py
!digest/orbite.py
!digest/template.html
!digest/nginx.conf
!digest/run.sh
!reports/*.md
!discord-bridge/bot.py
!discord-bridge/Dockerfile
!discord-bridge/requirements.txt
!dev-agents/agent.py
!dev-agents/Dockerfile
!dev-agents/requirements.txt
!dev-agents/dashboard.html
!paperless-ngx/protonmail-bridge/Dockerfile
# gh-runners : scripts et doc, jamais secrets/ ni .env
!gh-runners/README.md
!gh-runners/.env.example
!gh-runners/runner-entrypoint.sh
!gh-runners/token-broker.sh

# Explicitly exclude homepage config containing secrets
homepage/config/services.yaml

# Nested application checkouts — each has its own git remote, not ours to
# vendor. Their .env files are still protected offsite by state-backup.sh.
the-box/repo/
printcast/
battistella-pro/
